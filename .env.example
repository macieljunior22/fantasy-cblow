NEXT_PUBLIC_SUPABASE_URL=https://toxvbcnknhutntmvpmza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KLfJFxMqjFhKbY-qBjRrzA_W5G3zMPL

# SECRETA — somente servidor / script local. Ignora RLS. Jamais use NEXT_PUBLIC_ nela.
# Pegue em: Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_AQUI_A_SERVICE_ROLE_KEY

# URL pública do site (usada no redirect do login social)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Script local de captura (scripts/live-capture) ----
# ID da partida (tabela matches). Se vazio, usa a partida com status IN_PROGRESS.
MATCH_ID=
LOL_API_URL=https://127.0.0.1:2999/liveclientdata/allgamedata
POLL_INTERVAL_MS=4000
LATENCY_WARN_MS=1500
